{
  "name": "mfo",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft Farm Observatory — read-only observability platform for a Fabric technical server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/app/bootstrap.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/app/bootstrap.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "create-user": "tsx src/app/create-user.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mineflayer": "^4.37.1",
    "pino": "^10.3.1",
    "prismarine-nbt": "^2.8.0",
    "socket.io": "^4.8.3",
    "vec3": "^0.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prismarine-entity": "^2.6.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
