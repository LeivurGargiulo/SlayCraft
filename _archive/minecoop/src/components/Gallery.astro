---
import { Image } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
  alt: string;
}
const { images, alt } = Astro.props;
---

<div class="relative" data-gallery>
  <div
    class="flex snap-x snap-mandatory overflow-x-auto rounded border border-border bg-surface scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-track
  >
    {
      images.map((img) => (
        <div class="flex w-full shrink-0 snap-center items-center justify-center">
          <Image src={img} alt={alt} class="max-h-[70vh] w-full object-contain" />
        </div>
      ))
    }
  </div>

  {
    images.length > 1 && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Anterior"
          class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/90 px-3 py-2 text-lg leading-none hover:border-accent hover:text-accent"
        >
          ‹
        </button>
        <button
          type="button"
          data-next
          aria-label="Siguiente"
          class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/90 px-3 py-2 text-lg leading-none hover:border-accent hover:text-accent"
        >
          ›
        </button>
        <div class="mt-3 flex justify-center gap-2" data-dots>
          {images.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`Imagen ${i + 1}`}
              class="h-2 w-2 rounded-full bg-border transition-colors"
            />
          ))}
        </div>
      </>
    )
  }
</div>

<script data-astro-rerun>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];

    const activeIndex = () => Math.round(track.scrollLeft / track.clientWidth);

    const updateDots = () => {
      const i = activeIndex();
      dots.forEach((d, idx) => d.classList.toggle('bg-accent', idx === i));
    };

    const goTo = (i: number) => {
      track.scrollTo({ left: slides[i].offsetLeft, behavior: 'smooth' });
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(Math.max(0, activeIndex() - 1)));
    root
      .querySelector('[data-next]')
      ?.addEventListener('click', () => goTo(Math.min(slides.length - 1, activeIndex() + 1)));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    track.addEventListener('scroll', updateDots);
    updateDots();
  });
</script>
