---
interface Props {
  coordinates: string[];
}
const { coordinates } = Astro.props;

const parsed = coordinates.map((entry) => {
  const i = entry.indexOf(':');
  return i === -1 ? { label: null, value: entry } : { label: entry.slice(0, i).trim(), value: entry.slice(i + 1).trim() };
});
---

<ul class="flex flex-col gap-1.5">
  {
    parsed.map(({ label, value }) => (
      <li class="flex items-center justify-between gap-3 rounded border border-border bg-surface px-3 py-1.5 font-mono text-sm">
        <span class="truncate">
          {label && <span class="text-text-muted">{label}: </span>}
          {value}
        </span>
        <button
          type="button"
          data-copy={value}
          class="shrink-0 rounded border border-border px-2.5 py-1 text-xs text-text transition-colors hover:border-accent hover:text-accent"
        >
          Copiar
        </button>
      </li>
    ))
  }
</ul>
