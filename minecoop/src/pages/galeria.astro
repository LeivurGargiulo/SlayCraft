---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../content/galeria/img/*.{png,jpg,jpeg,svg,webp}',
  { eager: true }
);
const images = Object.values(imageModules).map((mod) => mod.default);
---

<BaseLayout title="Galería">
  <h1 class="text-2xl font-semibold">Galería</h1>
  <p class="mt-2 text-text-muted">Capturas del mundo.</p>

  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      images.map((img, i) => (
        <button
          type="button"
          data-lightbox-trigger
          data-index={i}
          class="group overflow-hidden rounded-lg border border-border bg-surface transition-all hover:border-accent hover:shadow-md hover:shadow-black/40"
        >
          <Image
            src={img}
            alt=""
            width={1200}
            class="aspect-[4/3] w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
          />
        </button>
      ))
    }
  </div>

  <dialog id="lightbox" class="m-auto max-w-[90vw] rounded-lg border border-border bg-surface p-0 backdrop:bg-black/70">
    <form method="dialog" class="flex justify-end p-2">
      <button class="rounded border border-border px-2 py-1 text-xs text-text-muted hover:text-text">Cerrar ✕</button>
    </form>
    <div class="relative flex items-center px-4 pb-4">
      <button
        type="button"
        data-lightbox-prev
        aria-label="Anterior"
        class="absolute left-6 rounded-full border border-border bg-surface/90 px-3 py-2 text-text hover:border-accent hover:text-accent"
      >
        ‹
      </button>
      <img id="lightbox-img" src="" alt="" class="mx-auto max-h-[80vh] max-w-[90vw]" />
      <button
        type="button"
        data-lightbox-next
        aria-label="Siguiente"
        class="absolute right-6 rounded-full border border-border bg-surface/90 px-3 py-2 text-text hover:border-accent hover:text-accent"
      >
        ›
      </button>
    </div>
  </dialog>

  <script data-astro-rerun>
    const dialog = document.getElementById('lightbox') as HTMLDialogElement;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')];
    let current = 0;

    function show(index: number) {
      current = (index + triggers.length) % triggers.length;
      const thumb = triggers[current].querySelector('img') as HTMLImageElement;
      img.src = thumb.src;
      img.alt = thumb.alt;
    }

    triggers.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      });
    });

    document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  </script>
</BaseLayout>
