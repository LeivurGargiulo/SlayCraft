# Required by .mcp.json's task-master-ai server (used by Claude Code, not the app itself).
GOOGLE_API_KEY=

COOKIE_SECRET=change-me-to-a-long-random-string
MCFARMMANAGER_URL=http://mcserver:8642
# Must match the mcfarmmanagerApiToken carpet rule set on the Fabric server (/carpet mcfarmmanagerApiToken <token>).
# Required for farm create/edit-config/delete from the dashboard; GET routes work without it.
MCFARMMANAGER_API_TOKEN=
# Caddy terminates TLS for nyttlandmc.net.ar (see Caddyfile) and owns ports 80/443.
# Point an A record for that domain at your public IP before forwarding the port.
