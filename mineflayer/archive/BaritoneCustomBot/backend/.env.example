# ============================================
# Baritone AI — Backend Configuration
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ------ API Keys ------

# Google Gemini API key (required)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# ------ Gemini Settings ------

# Gemini model to use for decision-making
GEMINI_MODEL=gemini-2.5-flash

# Minimum delay (ms) between Gemini API calls to avoid rate limits
MIN_GEMINI_COOLDOWN_MS=2000

# ------ WebSocket Server ------

# Port for the WebSocket server (mod connects here)
WS_PORT=3000

# ------ Bot Identity ------

# In-game bot name — the bot responds when this name is mentioned in chat
BOT_NAME=Bot

# ------ Access Control ------

# Comma-separated list of player names allowed to command the bot
# Leave empty to allow everyone
BOT_WHITELIST=

# Comma-separated list of player names blocked from commanding the bot
# Leave empty to block nobody
BOT_BLACKLIST=

# ------ Debug ------

# Enable verbose logging (true/false)
DEBUG=false
